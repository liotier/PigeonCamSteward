#!/bin/sh
# postinst for pigeoncam - creates /etc/pigeoncam and a default
# config.yaml when one doesn't already exist, applies the tmpfiles
# fragment, and points a fresh install at the two scripts that finish
# setup. Idempotent (every step is safe to repeat on every upgrade, not
# just a first install) and safe under `set -e`, as Debian policy expects
# of a maintainer script.
#
# Deliberately does NOT enable or start any of the six systemd units
# dh_installsystemd would otherwise touch on its own - see debian/rules'
# override_dh_installsystemd (--no-enable --no-start) and
# docs/development/design/debian-packaging.md's "The units must not
# start on install": starting ffmpeg against an unconfigured config.yaml,
# no camera symlink, and no stream key would fail in a loop and make a
# poor first impression.
#
# DOES reach the network: it attempts the YouTube API integration's
# Python virtualenv (see the venv setup step below). This package does
# not target the official Debian archive, so the usual "postinst must
# work offline" caution does not bind us the way it binds a package
# aiming for `main` - ttf-mscorefonts-installer is the standing
# real-world precedent for exactly this, in `contrib` for that same
# reason. See docs/development/design/debian-packaging.md item 2.
#
# POSIX sh, not bash: Debian's /bin/sh is dash, and maintainer scripts
# are run with it regardless of what a build host's own /bin/sh happens
# to be symlinked to.

set -e

CONFDIR=/etc/pigeoncam
PREFIX=/usr/lib/pigeoncam

case "$1" in
    configure)
        # 0750, not the more common 0755: this directory ends up holding
        # the stream key and, if the operator turns on YouTube API access,
        # OAuth credentials - see docs/development/design/debian-packaging.md
        # item 3. install -d re-applies the mode even if the directory
        # already exists (verified), so an upgrade that runs this again
        # can't leave a looser mode in place from an older package version.
        install -d -m 0750 "$CONFDIR"

        # Exactly what `make install` already does for a non-package
        # install: never touch a config.yaml that's already there (an
        # operator's real, heavily-edited config), and 0640 rather than
        # world-readable, for the same reason as the directory above.
        if [ ! -e "$CONFDIR/config.yaml" ]; then
            install -m 0640 "$PREFIX/config.example.yaml" "$CONFDIR/config.yaml"
        fi

        # A container without the systemd machinery (no PID 1 systemd,
        # building an image, etc.) should not fail the whole install over
        # a tmpfiles directory that will simply get created for real the
        # first time this host actually boots under systemd.
        systemd-tmpfiles --create /etc/tmpfiles.d/pigeoncam.conf || true

        # The YouTube API integration's venv (see
        # docs/development/design/debian-packaging.md item 2). Attempted
        # unconditionally, on every install and every upgrade where it
        # isn't already there - not gated on youtube_api.enabled, because
        # on a FRESH install that key cannot yet be true: config.yaml has
        # either just been created above with the shipped false default,
        # or pigeoncam-setup.sh (which is what would turn it on) has not
        # run yet and never runs from here. Only an existing install
        # already opted in could have it true this early, and this same
        # unconditional attempt covers that case too.
        #
        # This IS a real, if small, cost for the majority of installs
        # that will never use this optional tier - accepted deliberately
        # in exchange for it simply working the moment someone flips
        # youtube_api.enabled, rather than that being the FIRST time they
        # discover a manual step exists. What matters more than the
        # policy question is that failure here must never matter: this
        # integration is optional and off by default, so an install must
        # not fail, hang, or even look different over a network hiccup
        # or a missing python3-venv. Every step is timeout-bounded, every
        # failure is caught and printed as a plain warning, and the
        # half-built venv (if `python3 -m venv` succeeded but `pip
        # install` did not finish) is deliberately left in place rather
        # than deleted - pigeoncam-doctor.sh's own check_youtube_api
        # already detects that exact state precisely (imports the
        # dependencies, not just checks the interpreter exists) and tells
        # the operator the one command that resumes it, which is simpler
        # than starting over.
        VENV_DIR=/var/lib/pigeoncam/venv
        VENV_READY=false
        if [ -x "$VENV_DIR/bin/python3" ]; then
            VENV_READY=true
        else
            echo "pigeoncam: setting up the YouTube API integration's Python virtualenv (optional - only used if you later turn on youtube_api.enabled; harmless if this fails, see below) ..."
            if command -v python3 >/dev/null 2>&1 \
                && timeout 120 python3 -m venv "$VENV_DIR" \
                && timeout 300 "$VENV_DIR/bin/pip" install --disable-pip-version-check -r "$PREFIX/api/requirements.txt"
            then
                echo "pigeoncam: venv ready at $VENV_DIR"
                VENV_READY=true
            else
                echo "pigeoncam: could not finish the venv automatically (see any output above - most likely no network yet, or python3-venv isn't installed). Nothing else depends on it. Retry any time: sudo apt install -y python3-venv && sudo python3 -m venv $VENV_DIR && sudo $VENV_DIR/bin/pip install -r $PREFIX/api/requirements.txt" >&2
            fi
        fi

        # $2 is only set on an upgrade (the previously-configured
        # version) - print the quickstart once, on a genuinely fresh
        # install, not on every single upgrade. Full paths throughout,
        # not the short pigeoncam-setup/pigeoncam-doctor/pigeoncam-ctl
        # forms: this package does not put anything on PATH (see
        # docs/development/design/debian-packaging.md's note on
        # debian/pigeoncam.links - adding those symlinks without also
        # updating every script's own printed messages to match would
        # leave some instructions right and others wrong, which is worse
        # than plain full paths everywhere).
        if [ -z "$2" ]; then
            cat <<EOM
pigeoncam is installed but not started.
  1. sudo $PREFIX/bin/pigeoncam-setup.sh     answer the questions
  2. sudo $PREFIX/bin/pigeoncam-doctor.sh    fix anything it reports
  3. sudo $PREFIX/bin/pigeoncam-ctl.sh enable && sudo $PREFIX/bin/pigeoncam-ctl.sh start
The udev rule needs your camera's IDs first - see
/usr/share/doc/pigeoncam/udev/99-pigeoncam.rules.example
See /usr/share/doc/pigeoncam/README.Debian for the yt-dlp update timer
and what survives 'apt remove' versus 'apt purge'.
EOM
            if ! $VENV_READY; then
                echo "The optional YouTube API integration's venv could not be set up automatically - see the warning above. Everything else works without it."
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
