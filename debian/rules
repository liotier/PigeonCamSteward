#!/usr/bin/make -f
# debian/rules for pigeoncam.
#
# No build step - this is shell, systemd units, and a udev rule (see the
# top of the project's own Makefile). Every override below either points
# an existing dh_* step at that Makefile's install target with the
# package's paths, or turns a step off because it does not apply here.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	# nothing to build

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/pigeoncam \
	    PREFIX=/usr/lib/pigeoncam \
	    DOCDIR=/usr/share/doc/pigeoncam \
	    UNITDIR=/lib/systemd/system \
	    CONFDIR=/etc/pigeoncam
	# `make install` creates /etc/pigeoncam/config.yaml from
	# config.example.yaml when one isn't already there, which is exactly
	# right for `make install` run directly but wrong for a package
	# build: config.yaml is generated by postinst instead (see there, and
	# docs/development/design/debian-packaging.md item 3), so a copy
	# baked into the .deb itself would fight dpkg's own idea of what it
	# shipped. Delete it here rather than teaching the Makefile a
	# "skip the config" flag it has no other use for - the reason stays
	# visible in this one line instead of split across two files.
	rm -f $(CURDIR)/debian/pigeoncam/etc/pigeoncam/config.yaml

override_dh_installsystemd:
	# --no-enable --no-start is not a style choice - see the design spec's
	# "The units must not start on install": all six units this project
	# ships with an [Install] section (pigeoncam-stream.service and the
	# five *.timer files) are enableable, and letting dh_installsystemd
	# enable-and-start them on a bare `apt install` would launch ffmpeg
	# against an unconfigured config.yaml, no camera symlink, and no
	# stream key - a package that breaks the machine it installs on.
	# postinst points at pigeoncam-setup.sh and pigeoncam-doctor.sh
	# instead, and says explicitly that nothing has been started.
	dh_installsystemd --no-enable --no-start

override_dh_compress:
	# Leave the Markdown alone. dh_compress gzips anything in
	# /usr/share/doc over a size threshold, which by default turns
	# README.md into README.md.gz and docs/TROUBLESHOOTING.md into
	# docs/TROUBLESHOOTING.md.gz - while 26 operator-facing messages
	# across six scripts print the UNcompressed path ("see
	# .../docs/TROUBLESHOOTING.md 'Real audio mode'"). Every one of those
	# pointers would name a file that is not there, at exactly the moment
	# someone is trying to fix a broken stream. Caught by installing the
	# built package and reading the paths it actually prints.
	# changelog and README.Debian keep the conventional .gz - they are
	# read through dpkg's own tooling, and nothing points at them by path.
	dh_compress -X.md

override_dh_auto_test:
	# the suite needs real ffmpeg/systemd-analyze and network; run it
	# from the source tree with `make check`, not from the package build
