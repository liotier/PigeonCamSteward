# Local configuration (deploy-specific; use config.example.yaml as the template)
config.yaml

# Stream keys / credentials — never commit these
*.key
stream_key*
*client_secret*.json
*token*.json
token.pickle
.env

# Tier 2 (api/) virtualenv, local OAuth artifacts, and rotation state
api/venv/
api/.venv/
tier2_state.json
*.pyc
__pycache__/

# Local archive / runtime artifacts if ever generated inside the checkout
*.ts
*.mp4
*.mkv
/archive/
/run/

# Editor/OS cruft
*.swp
.DS_Store

# dpkg-buildpackage/debhelper build artifacts (debian/ - see
# docs/development/design/debian-packaging.md) - all generated by a real
# build, none of them meant to be committed.
/debian/pigeoncam/
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/*.substvars
/debian/*.debhelper.log
# The maintainer-script fragments debhelper generates and then splices
# into postinst/postrm at dh_installdeb time (pigeoncam.postinst.debhelper
# and friends). Same name as the shipped debian/postinst but a different
# thing entirely - generated per build, never edited, never committed.
/debian/*.debhelper
/*.deb
/*.buildinfo
/*.changes
/*.dsc
/*.tar.gz
/*.tar.xz
